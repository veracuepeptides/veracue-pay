# Stripe — VeracuePay's own account. Charges are made directly on it (the same model as nextlvlpay).
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Webhook endpoint: https://<this site>/api/webhooks/stripe
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Registered merchants, as a JSON array on one line. Each business gets its own secret
# (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# A merchant is only active if it has id, name, origin and a 32+ character secret.
# altOrigins (other sites customers may return to), stripeAccountId (only for a Stripe Connect
# connected account), statementDescriptor, supportEmail and webhookUrl are optional.
# "origin" is also where webhook pings are sent by default: {origin}/api/webhooks/veracuepay.
VERACUEPAY_MERCHANTS=[{"id":"veracue","name":"Veracue Peptides","origin":"https://veracuepeptides.com","altOrigins":["https://www.veracuepeptides.com","https://veracue-peptides.vercel.app"],"secret":"replace_with_a_64_char_random_hex_string_unique_to_this_merchant","supportEmail":"support@veracuepeptides.com"}]

# Public identity of the platform (optional — defaults live in lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://veracuepay.com
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=support@veracuepay.com
NEXT_PUBLIC_BUSINESS_EMAIL=merchants@veracuepay.com
