# VeracuePay runs at https://veracuepay.com. Copy to .env.local for local work; on Vercel add the same names
# under Project Settings -> Environment Variables (Production), then redeploy: changes only apply to new builds.

# --- Stripe: VeracuePay's own account. Charges are made directly on it (the same model as nextlvlpay).
# Sandbox keys (sk_test_ / pk_test_) until go-live, then the live keys.
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Signing secret of the webhook endpoint https://veracuepay.com/api/webhooks/stripe
# (Stripe Dashboard -> Developers -> Webhooks). Events: payment_intent.succeeded,
# payment_intent.payment_failed, charge.refunded. Sandbox and live each have their own endpoint and secret.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- The shop that uses this payment page.
# Shown to customers on the payment page.
SHOP_NAME=Veracue Labs
# Where customers are returned after paying, and where webhook pings go ({SHOP_URL}/api/webhooks/veracuepay).
# Use the address the shop is live on today (the Vercel address until veracuelabs.com is connected), and
# change it to https://veracuelabs.com once it is. List every address customers may start from in
# SHOP_ALT_URLS too, including the Vercel one, because customers are only returned to listed addresses.
SHOP_URL=https://veracue-peptides.vercel.app
# Optional. Other addresses of the same shop customers may be returned to, comma separated.
SHOP_ALT_URLS=https://veracuelabs.com,https://www.veracuelabs.com
# Optional. Shown to customers on the payment page.
SHOP_SUPPORT_EMAIL=orders@veracuelabs.com
# Shared secret between this site and the shop. Use the SAME value in the shop's own environment
# (same variable name there). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERACUEPAY_API_SECRET=replace_with_64_random_hex_characters

# Only for more than one shop: a JSON array on one line. When set it is used instead of the SHOP_* variables
# above (see lib/merchants.ts for the fields).
# VERACUEPAY_MERCHANTS=[{"id":"acme","name":"Acme","origin":"https://acme.example","secret":"..."}]

# --- Public identity of VeracuePay. Defaults are in lib/site.ts; the site address defaults to
# https://veracuepay.com. Set it explicitly: it builds the canonical address, link previews and structured data.
NEXT_PUBLIC_SITE_URL=https://veracuepay.com
NEXT_PUBLIC_LEGAL_NAME=
# Shown on the payment page's error screens and the home page. Must be a mailbox that exists.
NEXT_PUBLIC_SUPPORT_EMAIL=support@veracuepay.com
NEXT_PUBLIC_BUSINESS_EMAIL=merchants@veracuepay.com
